---
/**
 * QuoteCard.astro —— 短句卡片
 * 只有一句话 + 出处，居中留白，安静。
 */
interface Props {
  text: string;
  source: string;
}

const { text, source, ...rest } = Astro.props;
---

<blockquote class="card quote-card" {...rest}>
  <span class="quote-mark" aria-hidden="true">「</span>
  <p class="quote-text">{text}</p>
  <footer class="quote-source">—— {source}</footer>
</blockquote>

<style>
  .quote-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 190px;
    padding: 28px 26px;
  }

  .quote-mark {
    font-size: 34px;
    line-height: 1;
    color: var(--accent-dim);
    opacity: 0.55;
    transition: color var(--dur-hover) var(--ease), opacity var(--dur-hover) var(--ease);
  }

  .quote-card:hover .quote-mark {
    color: var(--accent);
    opacity: 0.9;
  }

  .quote-text {
    margin-top: 14px;
    font-size: 16px;
    line-height: 1.95;
    letter-spacing: 0.03em;
    color: var(--text);
    transition: transform var(--dur-hover) var(--ease);
  }

  /* 悬停时短句文字向右轻移 2px（克制） */
  .quote-card:hover .quote-text {
    transform: translateX(2px);
  }

  .quote-source {
    margin-top: 20px;
    font-size: 11.5px;
    letter-spacing: var(--tracking-wide);
    color: var(--text-faint);
  }

  /* 关闭动效时不做位移 */
  @media (prefers-reduced-motion: reduce) {
    .quote-card:hover .quote-text {
      transform: none;
    }
  }
</style>

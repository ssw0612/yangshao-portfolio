---
/**
 * ImageCard.astro —— 图片卡片（可点开看大图）
 * ------------------------------------------------------------
 *  【两种用法】
 *  ① 真图：给 src（例如 src: '/images/01-stage.jpg'），显示真实图片。
 *     图片统一 4:3 裁切 + object-fit: cover —— 横图竖图混排也不会被拉变形。
 *  ② 没图（或图还没准备好）：给 gradient，用 CSS 渐变占位（不下载图片）。
 *
 *  【点开看大图（灯箱）】
 *   根元素是一个 <a>，href 指向大图 /images/full/同名文件。
 *   - 有 JS：脚本拦截点击 → 弹出灯箱（src/components/Lightbox.astro）。
 *   - 没 JS：点击就是浏览器直接打开那张大图 —— 内容照样看得到，不会白点。
 *   ★ 想自己指定大图，给 full 字段（例如 full: '/images/full/我的图.jpg'）；
 *     不填则自动把 /images/ 换成 /images/full/。
 */
interface Props {
  title: string;
  location?: string;
  src?: string;      // 缩略图地址（放在 public/images/ 下）
  full?: string;     // 灯箱大图地址（放在 public/images/full/ 下），不填自动推导
  alt?: string;      // 图片读不出来时显示的文字
  gradient?: string; // 没有真图时的渐变占位
  ratio?: 'square' | 'portrait' | 'landscape';
}

const {
  title,
  location,
  src,
  full,
  alt,
  gradient = 'linear-gradient(150deg, #232b35 0%, #131820 55%, #2f3a47 100%)',
  ratio = 'square',
  ...rest
} = Astro.props;

// 大图地址：优先用 full；否则把 /images/xxx.jpg 推成 /images/full/xxx.jpg
const fullSrc = full || (src ? src.replace('/images/', '/images/full/') : undefined);
---

<a
  class="photo-card-link"
  href={fullSrc}
  data-lightbox={fullSrc ? '' : undefined}
  data-thumb={src}
  data-title={title}
  data-meta={location || ''}
  data-cursor={fullSrc ? '放大' : undefined}
  aria-label={fullSrc ? `查看大图：${title}` : undefined}
  {...rest}
>
  <figure class="card photo-card">
    <div class:list={['photo-frame', `ratio-${ratio}`, { 'has-img': Boolean(src) }]}>
      {
        src ? (
          <img class="photo-img" src={src} alt={alt || title} loading="lazy" decoding="async" />
        ) : (
          <div class="photo-fill" style={`background: ${gradient};`}></div>
        )
      }
      <div class="photo-sheen" aria-hidden="true"></div>
    </div>

    <figcaption class="photo-caption">
      <h3 class="photo-title">{title}</h3>
      {location && <p class="photo-location">{location}</p>}
    </figcaption>
  </figure>
</a>

<style>
  /* <a> 只是"整卡可点"的外壳，视觉全部由里面的 .card 承担 */
  .photo-card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .photo-card-link:hover {
    color: inherit;
  }

  .photo-card {
    overflow: hidden;
  }

  .photo-frame {
    position: relative;
    overflow: hidden;
    /* 悬停时图片轻微放大 + 整体略亮（只动 transform / filter） */
    transition:
      transform 0.6s var(--ease),
      filter var(--dur-hover) var(--ease);
  }

  .photo-card:hover .photo-frame {
    transform: scale(1.03);
    filter: brightness(1.1);
  }

  .ratio-square { aspect-ratio: 1 / 1; }
  .ratio-portrait { aspect-ratio: 4 / 5; }
  .ratio-landscape { aspect-ratio: 3 / 2; }

  /* 真图：横竖混排统一用 4:3 裁切，cover 保证不变形 */
  .photo-frame.has-img {
    aspect-ratio: 4 / 3;
    background-color: #0d0d11;
  }

  .photo-img,
  .photo-fill {
    display: block;
    width: 100%;
    height: 100%;
  }

  .photo-img {
    object-fit: cover;
    object-position: center;
  }

  /* 一层斜向微光，悬停时缓慢扫过，像展柜玻璃反光 */
  .photo-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      transparent 30%,
      rgba(232, 234, 237, 0.05) 50%,
      transparent 70%
    );
    opacity: 0;
    transform: translateX(-20%);
    transition:
      opacity var(--dur-hover) var(--ease),
      transform 0.9s var(--ease);
  }

  .photo-card:hover .photo-sheen {
    opacity: 1;
    transform: translateX(20%);
  }

  .photo-caption {
    padding: 16px 18px 18px;
  }

  .photo-title {
    font-size: 14.5px;
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    color: var(--text);
    transition: color var(--dur-hover) var(--ease);
  }

  .photo-card:hover .photo-title {
    color: var(--accent);
  }

  .photo-location {
    margin-top: 6px;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--text-faint);
  }

  /* 关闭动效时不做缩放（保留亮度/边框等非位移变化） */
  @media (prefers-reduced-motion: reduce) {
    .photo-card:hover .photo-frame {
      transform: none;
    }
  }
</style>

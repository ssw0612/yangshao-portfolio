---
/**
 * writings/[...slug].astro —— 文章详情页（路径 /writings/{slug}）
 * ------------------------------------------------------------
 *  一篇文章一个页面，正文直接渲染 src/content/writings/ 里的 .md。
 *  网址里的 slug 就是 md 的文件名（liji-lita.md → /writings/liji-lita）。
 *  正文样式：深色底、最大行宽 70ch、行高 1.8（长文读起来不累）。
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

// 构建时为每篇文章生成一个页面
export async function getStaticPaths() {
  const writings = await getCollection('writings');
  return writings.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, date, period, type, summary } = entry.data;

// 类型 → 中文标签
const TYPE_LABEL = { essay: '论述', poem: '诗歌', interview: '访谈' };
const typeLabel = TYPE_LABEL[type] || type;

// 日期格式化：2023-03-12 → 2023.03.12
const dateText = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`;
---

<Base title={`${title} · 仰韶`} description={summary}>
  <main>
    <header class="page-head">
      <div class="container">
        <a class="back-link" href="/writings">← 返回文章</a>
        <p class="page-eyebrow">WRITING</p>
        <h1 class="page-title">{title}</h1>
        <p class="article-meta">
          <span>{dateText}</span>
          <span class="article-dot" aria-hidden="true">·</span>
          <span>{period}</span>
          <span class="article-dot" aria-hidden="true">·</span>
          <span class="article-tag">{typeLabel}</span>
        </p>
      </div>
    </header>

    <section class="page-body">
      <div class="container">
        <!-- 正文：md 渲染出来的内容都放在 .prose 里统一排版 -->
        <article class:list={['prose', { 'is-poem': type === 'poem' }]}>
          <Content />
        </article>

        <a class="back-link back-link--bottom" href="/writings">← 返回文章</a>
      </div>
    </section>
  </main>
</Base>

<style>
  /* ---------- 返回链接 ---------- */
  .back-link {
    display: inline-block;
    margin-bottom: 22px;
    font-size: 12.5px;
    letter-spacing: var(--tracking-xwide);
    color: var(--accent);
    transition: color var(--dur-hover) var(--ease);
  }

  .back-link:hover {
    color: var(--text);
  }

  .back-link--bottom {
    margin-top: 56px;
    margin-bottom: 0;
  }

  /* ---------- 标题下方的 meta（日期 · 时期 · 类型） ---------- */
  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
    font-size: 11.5px;
    letter-spacing: var(--tracking-wide);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .article-dot {
    color: var(--accent-dim);
  }

  .article-tag {
    padding: 2px 9px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-soft);
  }

  /* ---------- 正文排版 ---------- */
  .prose {
    /* 最大行宽约 70 个字符：一行太长眼睛累，太短读得碎 */
    max-width: 70ch;
    margin-top: 8px;
    padding: 34px 34px 38px;
    background-color: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .prose :global(p) {
    margin-top: 1.35em;
    font-size: 16px;
    line-height: 1.8;
    letter-spacing: 0.02em;
    color: var(--text-soft);
    text-align: justify;
  }

  .prose :global(p:first-child) {
    margin-top: 0;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin-top: 2em;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    color: var(--text);
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(a) {
    border-bottom: 1px solid var(--border-hover);
  }

  /* 有序/无序列表（访谈录里的问答编号会渲染成列表） */
  .prose :global(ol),
  .prose :global(ul) {
    margin-top: 1.35em;
    padding-left: 1.4em;
  }

  .prose :global(li) {
    margin-top: 0.7em;
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-soft);
  }

  /* 诗歌：行距再放宽一点，保留 md 里的换行（<br>） */
  .prose.is-poem :global(p) {
    line-height: 2.1;
    text-align: left;
  }

  /* ---------- 手机端：留白收紧，字号略降 ---------- */
  @media (max-width: 767px) {
    .prose {
      padding: 24px 20px 26px;
    }

    .prose :global(p),
    .prose :global(li) {
      font-size: 15.5px;
      line-height: 1.85;
      text-align: left;
    }
  }
</style>

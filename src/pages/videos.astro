---
/**
 * videos.astro —— 视频作品独立页（路径 /videos）
 * ------------------------------------------------------------
 *  3 条作品：1 条本地视频（内嵌播放器），2 条抖音跳转卡。数据在 works.js 的 videos。
 *  顶部一排「多平台入口」（B 站 / 抖音 / 小红书 / 快手），数据在 works.js 的 platforms。
 *  【加作品】往 works.js 的 videos 数组里加一条即可（type: 'local' 或 'link'）。
 */
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import { videos, platforms } from '../data/works.js';

// 各平台图标（内联 SVG，不引图标库、不下载图片）。做成 key → svg 的映射表，
// 按 platform.label 查找；以后加平台只要在 works.js 里加数据 + 在这里补一条图标即可。
const ICONS = {
  'B 站':
    '<rect x="3" y="7" width="18" height="13" rx="4"/><path d="M7 3l2.4 3M17 3l-2.4 3"/><path d="M9.5 12.5v3M14.5 12.5v3"/>',
  '抖音':
    '<path d="M14 4v10.6a3.6 3.6 0 1 1-3.1-3.57"/><path d="M14 4c.55 2.4 2.3 3.75 4.7 3.95"/>',
  '小红书':
    '<rect x="5" y="3" width="14" height="18" rx="3"/><path d="M9 8h6M9 12h6M9 16h3"/>',
  // 快手：橙色圆角底 + 白色简化图形（不下载图片、不引图标库）
  '快手':
    '<rect x="2.5" y="2.5" width="19" height="19" rx="5.5" fill="#FF5000" stroke="none"/><path d="M9.6 7.4c1.6.2 2.7 1 3.3 2.4.5-1 1.4-1.6 2.5-1.7v2.3c-.9.1-1.6.7-1.9 1.6h1.4c.7 0 1.2.5 1.2 1.2s-.5 1.2-1.2 1.2h-1.5c-.3 2-1.8 3.4-3.8 3.4-2.2 0-3.9-1.6-3.9-3.7 0-1.3.7-2.4 1.6-3-.5-.5-.9-1.3-.9-2.1 0-1.3 1-2.4 2.2-2.6z" fill="#fff" stroke="none"/>',
};

// 取图标路径；找不到就用一个通用圆点，避免报错（以后加平台忘配图标也不会崩）
const iconOf = (label) => ICONS[label] || '<circle cx="12" cy="12" r="8"/>';
---

<Base title="影像 · 仰韶" description="仰韶的影像作品：本地剪辑习作与抖音作品。">
  <main>
    <header class="page-head">
      <div class="container">
        <p class="page-eyebrow">FILM / VIDEO</p>
        <h1 class="page-title">影像</h1>
        <p class="page-desc">
          剪辑习作与抖音作品。标着「本地作品」的那条可以直接在这里播放，
          其余两条点开会去抖音看（新窗口打开）。
        </p>
      </div>
    </header>

    <section class="page-body">
      <div class="container">
        <!-- 多平台入口：一行横向按钮。href 为空时显示为不可点的「待补充」灰态 -->
        <div class="platform-bar" data-reveal>
          {platforms.map((p) =>
            p.href ? (
              <a class="platform-btn" href={p.href} target="_blank" rel="noopener noreferrer">
                <span class="platform-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={iconOf(p.label)} />
                </span>
                <span class="platform-name">{p.label}</span>
              </a>
            ) : (
              <span class="platform-btn platform-btn--todo" aria-disabled="true">
                <span class="platform-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={iconOf(p.label)} />
                </span>
                <span class="platform-name">{p.label}</span>
                <span class="platform-note">{p.note || '待补充'}</span>
              </span>
            )
          )}
        </div>

        <div class="grid grid-2 grid-video">
          {videos.map((v) => <VideoCard {...v} data-reveal />)}
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  /* 视频页用两列，卡片比首页更宽，观感更"放大" */
  @media (min-width: 768px) {
    .grid-video {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }

  /* ---------- 多平台入口条 ---------- */
  .platform-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 36px;
  }

  .platform-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background-color: var(--bg-soft);
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--text-soft);
    transition:
      color var(--dur-hover) var(--ease),
      border-color var(--dur-hover) var(--ease),
      background-color var(--dur-hover) var(--ease);
  }

  a.platform-btn:hover {
    color: var(--text);
    border-color: var(--border-hover);
    background-color: var(--bg-softer);
  }

  /* 不可点的「待补充」灰态：半透明、鼠标不为手型 */
  .platform-btn--todo {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .platform-icon {
    display: inline-flex;
    width: 16px;
    height: 16px;
  }

  .platform-icon svg {
    width: 16px;
    height: 16px;
  }

  .platform-note {
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }

  @media (max-width: 767px) {
    .platform-bar {
      gap: 10px;
      margin-bottom: 28px;
    }

    .platform-btn {
      padding: 8px 14px;
      font-size: 12.5px;
    }
  }
</style>
